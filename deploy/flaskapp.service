[Unit]
Description=Gunicorn - Flask Fraud Detection
After=network.target

[Service]
User=flaskapp
Group=flaskapp
WorkingDirectory=/opt/flaskapp
EnvironmentFile=/etc/flaskapp.env
ExecStart=/opt/flaskapp/venv/bin/gunicorn -c deploy/gunicorn.conf.py wsgi:app
Restart=always
RestartSec=3
# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/var/log/flaskapp /opt/flaskapp/instance

[Install]
WantedBy=multi-user.target
